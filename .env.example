# ==========================================
# RunSync 跑友圈 - 環境變數設定範本 (.env.example)
# ==========================================

# 1. 後端伺服器埠號
PORT=3001

# 2. PostgreSQL 連線字串 (支援本地 PostgreSQL 或雲端如 Supabase, Neon, Railway 等)
DATABASE_URL=postgresql://postgres:password@localhost:5432/running_record

# 3. LINE LIFF 設定 (用於前端身分驗證)
LINE_LIFF_ID=your_liff_id_here
LINE_LIFF_CHANNEL_ID=your_line_login_channel_id_here

# 4. LINE Messaging API (若已有長效 Token 可在此配置，或直接於前端介面設定)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_GROUP_ID=your_target_group_id_here
