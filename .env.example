# ==========================================
# RunSync 跑友圈 - 環境變數設定範本 (.env.example)
# ==========================================

# 1. 後端伺服器埠號
PORT=3001

# 2. PostgreSQL 連線字串 (資料庫名稱大小寫需與實際一致)
DATABASE_URL=postgresql://postgres:password@localhost:5432/Running_record
# 日期統計 (今日 / 本週 / 本月) 使用的時區
APP_TIMEZONE=Asia/Taipei

# 3. 身分驗證
# dev：以 DEV_LINE_ID 模擬登入 (前端也可用 localStorage 的 devLineId 切換身分測試)
# 未設定 (正式環境)：驗證 LIFF ID Token，需設定下方 LINE_LIFF_ID 與 LINE_LIFF_CHANNEL_ID
# 首次以 LINE 登入的人會自動成為「待審核」，由管理員在成員管理頁核准
AUTH_MODE=dev
DEV_LINE_ID=U_dev_admin

# 管理員的 LINE userId (U 開頭 33 碼)，啟動時自動設為已核准的管理員
# 可在 LINE Developers Console > LINE Login Channel > Basic settings >「Your user ID」查到
ADMIN_LINE_ID=U_dev_admin
ADMIN_NAME=管理員

# 4. 對外網址 (LINE 戰報中的大頭照需為完整 https 網址)
PUBLIC_BASE_URL=

# 5. LINE LIFF 設定 (用於前端身分驗證)
LINE_LIFF_ID=your_liff_id_here
LINE_LIFF_CHANNEL_ID=your_line_login_channel_id_here

# 6. LINE Messaging API 長效 Token (打卡後私訊戰報給其他跑友；前端設定頁填的值優先)
# Messaging API Channel 需與 LIFF 的 LINE Login Channel 在同一個 Provider 下
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
